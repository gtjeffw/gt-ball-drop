{
  "name": "gt-ball-drop",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "GT Ball Drop dual-task experiment: web port of the C4-engine original",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "npm run build -w @gtbd/game-web -w @gtbd/admin-web",
    "dev:participant": "node scripts/dev.mjs participant",
    "dev:admin": "node scripts/dev.mjs admin",
    "desktop": "npm run build:web && npm run build -w @gtbd/desktop && electron apps/desktop",
    "desktop:admin": "npm run build:web && npm run build -w @gtbd/desktop && electron apps/desktop --role=admin",
    "convert-c4-config": "tsx tools/convert-c4-config.ts",
    "build:demo": "npm run build:demo -w @gtbd/game-web",
    "dev:demo": "npm run dev:demo -w @gtbd/game-web"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
